CENSUS_API_KEY=
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Deployed D4 API base URL, used by app/verify_api.py (or pass --deployed-url)
API_URL=

# Website origin the deployed API allows through CORS (app/modal_api.py reads it at deploy time; origin only, no trailing slash).
