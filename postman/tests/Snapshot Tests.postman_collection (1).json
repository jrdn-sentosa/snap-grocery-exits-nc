ax_leaf_nodes\": 2,\n      \"min_samples_leaf\": 100,\n      \"l2_regularization\": 0,\n      \"max_iter\": 300,\n      \"early_stopping\": false,\n      \"categorical_features\": \"from_dtype\",\n      \"random_state\": 2026\n    },\n    \"baseline_log_odds\": -3.173424305254799,\n    \"unemployment_median\": 0.08414766558089033,\n    \"store_type_categories\": [\n      \"Large Grocery Store\",\n      \"Medium Grocery Store\",\n      \"Small Grocery Store\",\n      \"Super Store\",\n      \"Supermarket\"\n    ],\n    \"income_reference_years\": [\n      2012,\n      2013,\n      2014,\n      2015,\n      2016,\n      2017,\n      2018,\n      2019,\n      2020,\n      2021,\n      2022,\n      2023,\n      2024\n    ],\n    \"income_reference_n\": {\n      \"2012\": 2053,\n      \"2013\": 2147,\n      \"2014\": 2167,\n      \"2015\": 2142,\n      \"2016\": 2171,\n      \"2017\": 2147,\n      \"2018\": 2145,\n      \"2019\": 2107,\n      \"2020\": 2119,\n      \"2021\": 2117,\n      \"2022\": 2144,\n      \"2023\": 2162,\n      \"2024\": 2133\n    },\n    \"transformer\": \"store_prep.StoreFeaturePrep (src/model/store_prep.py)\"\n  },\n  \"self_check_passed\": true,\n  \"limits\": [\n    \"Estimates a store's chance of losing SNAP authorization within 12 months of Jan 1, with ownership changes not counted as exits and administrative batch ends counted as exits (exit_12m). It does not say a store will close.\",\n    \"Discrimination is modest: 2012-2018 model validation PR-AUC 0.149 against a 3.5% exit rate; top-50-per-year precision 25%. Say 'higher risk', not 'will exit'.\",\n    \"Fairness: dropping the seven tract demographic inputs did not narrow the majority-Black vs majority-White false-positive gap (4.1% vs 1.5% with them, 4.6% vs 1.2% without, validation, top 50 per year); it is plausibly carried by store type and chain size. To be reported on the test set in D6 (docs/changes_since_d3.md).\",\n    \"The 2022-2024 cohorts have never been scored. The refit model's only evaluation is the D6 test run.\"\n  ]\n}"
